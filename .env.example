# Generate each secret with: openssl rand -hex 32
API_TOKEN=
APP_PASSWORD=
SESSION_SECRET=

# Host port for docker compose (container always listens on 8080)
HOST_PORT=8080
# Host address to bind (127.0.0.1 = local only; set to the Tailscale IP to reach it from the tailnet)
HOST_BIND=127.0.0.1
# Set to false only when serving over plain HTTP (login works, but no PWA install or push)
COOKIE_SECURE=true
# Telegram notification for every transaction from email (empty = off)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional AI assistant (chat at #/chat), answered by your Hermes agent. Empty URL = off.
# Needs API_SERVER_ENABLED=true and API_SERVER_KEY in ~/.hermes/.env (see README).
HERMES_API_URL=
HERMES_API_KEY=
# Models to pick from in the chat, "provider:model" comma-separated; first = default.
# Empty = whatever Hermes uses by default. Example: 9router:cc/claude-sonnet-5-5,9router:cx/gpt-5.5
CHAT_MODELS=
